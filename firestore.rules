rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userDoc(uid) {
      return get(userPath(uid));
    }

    function userExists(uid) {
      return exists(userPath(uid));
    }

    function currentRole() {
      return signedIn() && userExists(request.auth.uid)
        ? userDoc(request.auth.uid).data.role
        : null;
    }

    function isActive() {
      return signedIn() && userExists(request.auth.uid) && userDoc(request.auth.uid).data.active == true;
    }

    function isAdmin() {
      return isActive() && currentRole() == 'admin';
    }

    function isTeacher() {
      return isActive() && currentRole() == 'teacher';
    }

    function isStudent() {
      return isActive() && currentRole() == 'student';
    }

    function subjectPath(subjectId) {
      return /databases/$(database)/documents/subjects/$(subjectId);
    }

    function teachesSubject(subjectId) {
      return exists(subjectPath(subjectId)) &&
        get(subjectPath(subjectId)).data.teacherId == request.auth.uid;
    }

    function enrollmentPath(studentId, subjectId) {
      return /databases/$(database)/documents/enrollments/$(studentId)_$(subjectId);
    }

    function isEnrolled(studentId, subjectId) {
      return exists(enrollmentPath(studentId, subjectId));
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isActive() && request.auth.uid == userId);
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /subjects/{subjectId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAdmin()
        || (isTeacher() && teachesSubject(resource.data.subjectId))
        || (isStudent() && request.auth.uid == resource.data.studentId);
      allow create, update, delete: if isAdmin();
    }

    match /assignments/{assignmentId} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (isStudent() && isEnrolled(request.auth.uid, resource.data.subjectId));
      allow create, update, delete: if isAdmin()
        || (isTeacher()
          && request.resource.data.teacherId == request.auth.uid
          && teachesSubject(request.resource.data.subjectId));
    }

    match /submissions/{submissionId} {
      allow read: if isAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid)
        || (
          isTeacher()
          && exists(/databases/$(database)/documents/assignments/$(resource.data.assignmentId))
          && get(/databases/$(database)/documents/assignments/$(resource.data.assignmentId)).data.teacherId == request.auth.uid
        );
      allow create, update: if isAdmin()
        || (isStudent() && request.resource.data.studentId == request.auth.uid)
        || (
          isTeacher()
          && exists(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId))
          && get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data.teacherId == request.auth.uid
        );
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin()
        || (isTeacher() && teachesSubject(resource.data.subjectId))
        || (isStudent() && isEnrolled(request.auth.uid, resource.data.subjectId));
      allow create, update, delete: if isAdmin()
        || (isTeacher() && teachesSubject(request.resource.data.subjectId));
    }

    match /announcements/{announcementId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin()
        || (isTeacher() && request.resource.data.createdBy == request.auth.uid);
    }

    match /materials/{materialId} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (isStudent() && isEnrolled(request.auth.uid, resource.data.subjectId));
      allow create, update, delete: if isAdmin()
        || (
          isTeacher()
          && request.resource.data.teacherId == request.auth.uid
          && teachesSubject(request.resource.data.subjectId)
        );
    }
  }
}
